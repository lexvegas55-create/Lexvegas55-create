<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chibest Multibiz Global</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700;800&family=Work+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    --navy:#14213D;
    --amber:#F4A100;
    --coral:#E8482C;
    --teal:#1B9E85;
    --cream:#FDF8F0;
    --ink:#14213D;
  }
  *{margin:0;padding:0;box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    background:var(--cream);
    color:var(--ink);
    font-family:'Work Sans',sans-serif;
    line-height:1.5;
    overflow-x:hidden;
  }
  h1,h2,h3{font-family:'Sora',sans-serif;font-weight:800;letter-spacing:-0.01em;}
  a{color:inherit;}
  .wrap{max-width:1100px;margin:0 auto;padding:0 24px;}

  /* NAV */
  header{
    display:flex;justify-content:space-between;align-items:center;
    padding:22px 24px;max-width:1100px;margin:0 auto;
  }
  .logo{font-family:'Sora',sans-serif;font-weight:800;font-size:1.25rem;}
  .logo span{color:var(--coral);}
  nav a{
    text-decoration:none;font-weight:600;font-size:0.95rem;margin-left:28px;
  }
  nav a:hover{color:var(--coral);}
  .nav-links{display:flex;}
  @media(max-width:640px){ .nav-links{display:none;} }

  /* HERO */
  .hero{
    padding:60px 24px 90px;max-width:1100px;margin:0 auto;
    display:grid;grid-template-columns:1.1fr 0.9fr;gap:50px;align-items:center;
  }
  @media(max-width:800px){ .hero{grid-template-columns:1fr;padding-top:20px;} }
  .hero h1{
    font-size:clamp(2.4rem,5vw,3.6rem);
    line-height:1.05;
    margin-bottom:22px;
  }
  .hero p.lede{
    font-size:1.1rem;max-width:460px;margin-bottom:30px;color:#3A4560;
  }
  .btn-row{display:flex;gap:14px;flex-wrap:wrap;}
  .btn{
    display:inline-block;padding:14px 26px;border-radius:6px;font-weight:600;
    text-decoration:none;font-size:0.98rem;transition:transform .15s ease;
  }
  .btn:hover{transform:translateY(-2px);}
  .btn-primary{background:var(--coral);color:#fff;}
  .btn-secondary{background:transparent;color:var(--navy);border:2px solid var(--navy);}

  /* mosaic */
  .mosaic{
    display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;
    gap:14px;height:340px;
  }
  .tile{border-radius:10px;display:flex;align-items:flex-end;padding:16px;
    font-family:'Sora',sans-serif;font-weight:700;color:#fff;font-size:0.95rem;}
  .tile:nth-child(1){background:var(--amber);grid-row:1/3;}
  .tile:nth-child(2){background:var(--teal);}
  .tile:nth-child(3){background:var(--coral);}
  .tile:nth-child(4){background:var(--navy);grid-column:2/3;}
  @media(max-width:800px){ .mosaic{height:260px;margin-top:10px;} }

  /* STRIP */
  .strip{
    background:var(--navy);color:#fff;padding:16px 0;overflow:hidden;
    white-space:nowrap;font-family:'Sora',sans-serif;font-weight:700;font-size:1.05rem;
  }
  .strip .track{display:inline-block;padding-left:100%;animation:scroll 22s linear infinite;}
  .strip span{margin:0 32px;color:var(--amber);}
  @keyframes scroll{ 0%{transform:translateX(0);} 100%{transform:translateX(-100%);} }

  /* SECTIONS */
  section{padding:80px 24px;max-width:1100px;margin:0 auto;}
  .section-head{max-width:560px;margin-bottom:44px;}
  .section-head .eyebrow{color:var(--coral);font-weight:600;font-size:0.95rem;margin-bottom:8px;}
  .section-head h2{font-size:clamp(1.8rem,3.5vw,2.4rem);}
  .section-head p{color:#3A4560;margin-top:14px;font-size:1.05rem;}

  /* CATEGORIES */
  .cat-grid{
    display:grid;grid-template-columns:repeat(3,1fr);gap:20px;
  }
  @media(max-width:800px){ .cat-grid{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:520px){ .cat-grid{grid-template-columns:1fr;} }
  .cat-card{
    padding:26px 22px;border-radius:10px;background:#fff;
    border:1px solid #EAE2D3;
  }
  .cat-card .dot{width:38px;height:38px;border-radius:8px;margin-bottom:16px;}
  .cat-card h3{font-size:1.1rem;margin-bottom:8px;}
  .cat-card p{font-size:0.92rem;color:#5A6178;}

  /* WHY */
  .why{background:var(--navy);color:#fff;border-radius:16px;}
  .why .section-head p{color:#C7CCE0;}
  .why .section-head .eyebrow{color:var(--amber);}
  .why-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;padding:0 24px 60px;max-width:1100px;margin:0 auto;}
  @media(max-width:800px){ .why-grid{grid-template-columns:1fr;} }
  .why-item .num{font-family:'Sora',sans-serif;font-weight:800;font-size:1.6rem;color:var(--amber);margin-bottom:10px;}
  .why-item h3{font-size:1.05rem;margin-bottom:8px;}
  .why-item p{font-size:0.92rem;color:#C7CCE0;}

  /* CONTACT */
  .contact-box{
    background:var(--amber);border-radius:16px;padding:56px 40px;
    display:grid;grid-template-columns:1.1fr 0.9fr;gap:40px;
  }
  @media(max-width:800px){ .contact-box{grid-template-columns:1fr;padding:36px 24px;} }
  .contact-box h2{font-size:clamp(1.7rem,3.5vw,2.2rem);margin-bottom:14px;}
  .contact-box p{color:#3A2A00;margin-bottom:20px;}
  .contact-list{list-style:none;}
  .contact-list li{margin-bottom:16px;font-weight:600;}
  .contact-list .label{display:block;font-size:0.8rem;font-weight:500;color:#5A4300;margin-bottom:2px;}

  footer{
    text-align:center;padding:30px 24px;font-size:0.85rem;color:#7A8098;
  }
</style>
</head>
<body>

